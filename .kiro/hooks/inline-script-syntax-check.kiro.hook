{
  "enabled": true,
  "name": "Inline Script Syntax Check",
  "description": "When index.html is saved, syntax-check its inline <script> and report errors with line numbers.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["index.html"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "index.html was just saved. Run `node .kiro/hooks/check-inline-script.js index.html` from the repository root. The script extracts the inline <script> (ignoring external src scripts) and checks its syntax without executing it. If it prints OK, reply with one line saying the inline script has no syntax errors. If it reports errors, list each one with its message, the absolute line number in index.html, and the line number within the script, plus the offending source line. Do not print lines of index.html beyond what the script outputs (the file contains very long base64 lines). Do not modify any files unless the user asks you to fix the errors."
  }
}
